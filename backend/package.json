{
  "name": "backend",
  "version": "1.0.0",
  "description": "setup instruction:(execute the following on git bash in the project root)",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest --runInBand --detectOpenHandles tests/unit",
    "test:integration": "jest --runInBand --detectOpenHandles tests/integration",
    "test:coverage": "jest --runInBand --detectOpenHandles --coverage",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "start:dev": "nodemon server.js",
    "lint": "node -c server.js && node -c src/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "stripe": "^22.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "roots": ["<rootDir>/tests"],
    "collectCoverageFrom": ["src/**/*.js", "!src/config/swagger.js"],
    "coverageDirectory": "coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belhassen-Zoghlami/Zen-Hotel-Backend.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Belhassen-Zoghlami/Zen-Hotel-Backend/issues"
  },
  "homepage": "https://github.com/Belhassen-Zoghlami/Zen-Hotel-Backend#readme"
}
